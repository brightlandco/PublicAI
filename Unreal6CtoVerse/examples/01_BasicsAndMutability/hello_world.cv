namespace Game::Intro;
class Greeter {
  public:
    string Prefix = "Welcome to UE6";
  private:
    int GreetCount = 0;

  public:
    string FormatGreeting(string playerName) {
      GreetCount += 1;
      return "{Prefix}, {playerName}! (Visit #{GreetCount})";
    }

    int GetTotalGreets() const {
      return GreetCount;
    }
}
