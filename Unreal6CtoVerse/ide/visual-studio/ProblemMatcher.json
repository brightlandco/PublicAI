{
  "problemMatcher": {
    "owner": "cvc",
    "fileLocation": ["relative", "${workspaceFolder}"],
    "pattern": {
      "regexp": "^(.*)\\((\\d+),(\\d+)\\):\\s+(warning|error)\\s+(CV\\d+):\\s+(.*)$",
      "file": 1,
      "line": 2,
      "column": 3,
      "severity": 4,
      "code": 5,
      "message": 6
    }
  }
}
